# Default Foundry resource (plain `llm` / `llm_direct`, GPT-5.4 transcript writer)
FOUNDRY_ENDPOINT=https://<resource>.services.ai.azure.com/openai/v1
FOUNDRY_API_KEY=            # optional; Entra ID (az login) is used when empty

# Transcript writer model id from data/models.yaml (for `generate --writer`)
FOUNDRY_GEN_MODEL=

# Benchmark Foundry resources referenced by data/models.yaml and the OpenAI embedding matcher
BENCH_OPENAI_ENDPOINT=https://<resource>.openai.azure.com/openai/v1/
BENCH_MODELS_ENDPOINT=https://<resource>.services.ai.azure.com/openai/v1/
BENCH_API_KEY=              # key for BENCH_* endpoints; optional, Entra ID when empty

# Local / Hugging Face models (downloaded on first use if not already cached)
GLINER_MODEL=fastino/gliner2.5-base-v1
GLINER_DECIDE_MODEL=fastino/GLiNER2.5-Decide
EMBED_MODEL=sentence-transformers/all-MiniLM-L6-v2

# Shortlist embeddings for LLM and GLiNER matchers: openai (default) or minilm
SHORTLIST_EMBED=openai

# Safety switch: 1 means use caches only and never make paid LLM / embedding calls
LLM_CACHE_ONLY=0

# Fallback prices (USD per million tokens) for models with price: null in models.yaml
PRICE_INPUT_PER_M=
PRICE_OUTPUT_PER_M=
